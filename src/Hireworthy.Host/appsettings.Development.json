{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ai": {
    "Provider": "Mock"
  },
  "Auth": {
    "Dev": {
      // A caller who sends NO X-Dev-Roles header gets no roles at all, not system_admin. The
      // platform's default is system_admin for a smooth first run; a product that decides who gets
      // a job closes that gap, because a header-stripping proxy must degrade a caller and never
      // escalate one (plenipo#167, kit invariant S09). Every client in the test suite and the
      // .http catalog labels itself, so only unlabelled callers change.
      "RolesWhenAbsent": ""
    }
  },
  "DataProtection": {
    "KeysPath": "data/dataprotection-keys"
  },
  "Security": {
    "OutboundUrls": {
      "AllowHttp": true,
      "AllowPrivateNetworks": true
    }
  }
}
