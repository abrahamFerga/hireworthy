<Project Sdk="Microsoft.NET.Sdk">

  <!-- Boots the real host against a real Postgres via Testcontainers: platform + module migrations,
       real seeding, real job processor, real approval store. The Mock AI provider is the only
       stand-in, which is what lets rungs 3 and 4 run on a bare clone with no API key.
       Installed and owned by /deliver:install-runbook — re-running it reconciles this project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The conformance kit. It brings the host fixture, the AG-UI parser, the golden-eval runner
         and the platform's own invariant packs (S01–S15, R1–R4, manifest, tenancy) — and with them
         Testcontainers.PostgreSql and Microsoft.AspNetCore.Mvc.Testing at the platform's floors.
         Pinning either directly below that floor is NU1605 (Detected package downgrade), which is
         why neither appears here any more. -->
    <PackageReference Include="Plenipo.Testing" Version="$(PlenipoVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hireworthy.Host\Hireworthy.Host.csproj" />
  </ItemGroup>

  <!-- Golden-conversation evals are data, not code, and the kit's buildTransitive targets copy
       Evals\cases\*.json to the output for us — PlenipoGoldenEvals discovers them there. Its own
       "at least one case is committed" test fails loudly if that ever stops happening, which is
       what this project's hand-written Content item used to guard. -->

</Project>
